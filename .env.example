DATABASE_URL="postgresql://scheduler:scheduler@localhost:5432/scheduler?schema=public"

# Auth — Microsoft Entra ID (multi-tenant + personal accounts)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Resend — for transactional emails (invitations, password resets)
RESEND_API_KEY=
# EMAIL_FROM — must use a verified domain in Resend for delivery beyond the account owner's own inbox
# e.g. "Scheduler <notifications@yourdomain.com>"
EMAIL_FROM=

# Public base URL — used for all links in emails (booking, manage, password reset, invite)
# On production this MUST be set to the real domain, e.g. https://eureka-ent.org
NEXT_PUBLIC_BASE_URL=http://localhost:3000