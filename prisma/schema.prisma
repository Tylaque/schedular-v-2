generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  draft
  active
  paused
  closed
  archived
}

enum ParticipantStatus {
  invited
  link_sent
  booked
  reminded
  completed
  no_show
  cancelled
  waitlisted
}

enum WaitlistStatus {
  waiting
  offered
  expired
  claimed
  cancelled
}

enum BookingStatus {
  confirmed
  cancelled
  rescheduled
  completed
}

enum TeamsProvisionStatus {
  pending
  provisioned
  failed_personal_account
  failed_insufficient_permissions
  failed_unknown
}

enum MeetingPlatform {
  zoom
  teams
}

enum MeetingPlatformPreference {
  zoom
  teams
  auto
}

enum ZoomProvisionStatus {
  pending
  provisioned
  failed
}

enum EmailCategory {
  admin_invitation
  availability_request
  participant_invitation
  booking_confirmation
  reminder_24h
  reminder_1h
  reschedule_notice
  cancellation_notice
  waitlist_offer
  zoom_fallback_to_teams
  zoom_pool_full_no_fallback
}

enum EmailAudience {
  admin
  participant
  super_admin
}

enum AdminRole {
  admin
  super_admin
  org_owner
}

enum AdminAccountType {
  organizational
  personal
  no_microsoft
  unknown
}

enum NotificationStatus {
  sent
  failed
  test
}

model Admin {
  id                 String              @id @default(cuid())
  name               String
  initials           String              @default("")
  email              String              @unique
  emailVerified      DateTime?
  passwordHash       String?
  role               AdminRole           @default(admin)
  accountType        AdminAccountType    @default(unknown)
  projectAssignments ProjectAdmin[]
  // Superseded by availabilityRanges — candidate for removal once confirmed unused.
  availabilityEntries AdminAvailability[]
  availabilityRanges AdminAvailabilityRange[]
  bookings           Booking[]
  ownedProjects      Project[]           @relation("ProjectOwner")
  passwordResetTokens PasswordResetToken[]
  accounts           Account[]
  sessions           Session[]
  certifications     AdminCertification[] @relation("CertificationHolder")
  grantedCertifications AdminCertification[] @relation("CertificationGranter")
  isActive           Boolean            @default(true)
  deactivatedAt      DateTime?
  deactivatedBy      String?
  createdAt          DateTime            @default(now())
}

model Certification {
  id                 String   @id @default(cuid())
  name               String   @unique
  description        String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  adminCertifications AdminCertification[]
  projectRequirements  ProjectCertificationRequirement[]
}

model AdminCertification {
  id              String        @id @default(cuid())
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  certificationId String
  admin           Admin         @relation("CertificationHolder", fields: [adminId], references: [id], onDelete: Cascade)
  adminId         String
  grantedBy       Admin?        @relation("CertificationGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedById     String?
  grantedAt       DateTime      @default(now())

  @@unique([adminId, certificationId])
  @@index([adminId])
  @@index([certificationId])
}

model ProjectCertificationRequirement {
  id              String        @id @default(cuid())
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  certificationId String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  createdAt       DateTime      @default(now())

  @@unique([projectId, certificationId])
  @@index([projectId])
  @@index([certificationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user Admin @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user Admin @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id                        String         @id @default(cuid())
  slug                      String         @unique
  name                      String
  company                   String
  description               String
  durationMinutes           Int
  availabilityPeriodDays    Int
  dailyStart                String
  dailyEnd                  String
  includeWeekends           Boolean        @default(false)
  minNoticeHours            Int
  timezone                  String
  bookingDeadlineDays       Int
  bufferMinutes             Int
  maxSessionsPerAdminPerDay Int
  sessionCapacity           Int            @default(1)
  autoCompleteBookings      Boolean        @default(false)
  selfServiceWindowHours    Int            @default(4)
  status                    ProjectStatus  @default(draft)
  availabilityLockDate      DateTime
  brandingLogoInitial       String
  brandingPrimaryColor      String
  brandingSenderName        String
  admins                    ProjectAdmin[]
  availabilityEntries       AdminAvailability[]
  participants              Participant[]
  bookings                  Booking[]
  waitlistEntries           WaitlistEntry[]
  emailTemplates            EmailTemplate[]
  notificationLogs          NotificationLog[]
  auditLogs                 AuditLog[]
  certificationRequirements ProjectCertificationRequirement[]
  ownerId                   String?
  owner                     Admin?         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  meetingPlatformPreference MeetingPlatformPreference @default(auto)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
}

model ProjectAdmin {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  createdAt DateTime @default(now())

  @@unique([projectId, adminId])
}

model AdminAvailability {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  dateKey   String
  time      String
  createdAt DateTime @default(now())

  @@unique([projectId, adminId, dateKey, time])
  @@index([projectId, dateKey])
}

// Superseded by AdminAvailabilityRange — candidate for removal once confirmed
// nothing reads from it. Kept in place for historical data / reporting.
model AdminAvailabilityRange {
  id        String   @id @default(cuid())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  dateKey   String   // "YYYY-MM-DD"
  startTime String   // "09:00" — 24hr, minute precision
  endTime   String   // "17:00"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId, dateKey])
}

// Shared Zoom account pool (Server-to-Server OAuth model).
//
// The org owns a fixed set of licensed Zoom accounts ("pool accounts"). One
// account-level app credential set (ZOOM_ACCOUNT_ID / ZOOM_CLIENT_ID /
// ZOOM_CLIENT_SECRET) authenticates the whole pool via Zoom's
// Server-to-Server OAuth (grant_type=account_credentials). Pool rows only
// reference the licensed Zoom users — they do NOT hold per-account tokens.
// isActive soft-disables a pool account (same pattern as associate
// deactivation) without deleting any booking history.
model ZoomAccount {
  id         String   @id @default(cuid())
  label      String
  zoomUserId String   @unique
  zoomEmail  String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bookings Booking[]
}

model Participant {
  id           String            @id @default(cuid())
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  name         String
  email        String
  customFields Json?
  status       ParticipantStatus @default(invited)
  lastInvitedAt DateTime?
  createdAt    DateTime          @default(now())

  @@unique([projectId, email])
}

model Booking {
  id               String        @id @default(cuid())
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String
  admin            Admin         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId          String
  participantName  String
  participantEmail String
  dateKey          String
  time             String
  status           BookingStatus @default(confirmed)
  teamsMeetingId      String?
  calendarEventId     String?
  teamsProvisionStatus TeamsProvisionStatus?
  teamsJoinUrl        String?
  teamsErrorDetail    String?
  rescheduledFrom     Booking?      @relation("BookingReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledFromId String?      @unique
  rescheduledTo    Booking?      @relation("BookingReschedule")
  needsManualAttention Boolean    @default(false)
  manualAttentionReason String?
  meetingPlatform       MeetingPlatform?
  zoomAccount           ZoomAccount? @relation(fields: [zoomAccountId], references: [id], onDelete: SetNull)
  zoomAccountId         String?
  zoomMeetingId         String?
  zoomJoinUrl           String?
  zoomProvisionStatus   ZoomProvisionStatus?
  zoomErrorDetail       String?
  meetingFallbackReason String?
  createdAt             DateTime      @default(now())

  // No @@unique here — the old partial unique index (Booking_project_slot_confirmed_unique)
  // was dropped in migration 20260724200000 because it silently blocked sessionCapacity > 1.
  // Capacity is now enforced ENTIRELY by the application-level count-check inside
  // createBooking()'s serializable transaction (existingCount vs sessionCapacity before insert).

  @@index([adminId, dateKey])
}

model WaitlistEntry {
  id               String         @id @default(cuid())
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String
  name             String
  email            String
  dateKey          String?
  time             String?
  status           WaitlistStatus @default(waiting)
  offeredAt        DateTime?
  expiresAt        DateTime?
  claimedBookingId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([projectId, status, createdAt])
  @@index([projectId, dateKey, time, status])
}

model EmailTemplate {
  id               String            @id @default(cuid())
  category         EmailCategory
  audience         EmailAudience
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String?
  subject          String
  bodyHtml         String
  version          Int               @default(1)
  isActive         Boolean           @default(true)
  notificationLogs NotificationLog[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([category, projectId, isActive])
}

model NotificationLog {
  id             String              @id @default(cuid())
  template       EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId     String?
  category       EmailCategory
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId      String?
  recipientEmail String
  recipientRole  EmailAudience
  subject        String
  renderedBody   String
  status         NotificationStatus
  createdAt      DateTime            @default(now())
}

enum AuditAction {
  project_created
  project_updated
  admin_availability_submitted
  booking_created
  booking_cancelled
  booking_rescheduled
  booking_completed
  template_created
  template_updated
  notification_sent
  waitlist_joined
  role_changed
  org_ownership_transferred
  certification_created
  certification_updated
  certification_deleted
  admin_certifications_set
  project_certification_requirements_set
  admin_deactivated
  admin_reactivated
  zoom_fallback_to_teams
  zoom_pool_full_no_fallback
  zoom_provision_failed
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  actorType   String
  actorId     String?
  actorLabel  String
  entityType  String
  entityId    String
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  beforeState Json?
  afterState  Json?
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([projectId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  token     String   @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([adminId])
}
